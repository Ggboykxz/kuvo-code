{
  "name": "kuvo-code",
  "version": "0.7.1",
  "description": "Kuvo Code for Windows: a native shell around the engine and the conversation view.",
  "author": "Ggboykxz",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "smoke": "node smoke.js",
    "test:terminal": "node --test terminal.test.js ssh.test.js"
  },
  "dependencies": {
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "run.kuvo.code.windows",
    "productName": "Kuvo Code",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-check.js",
      "terminal.js",
      "ssh.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../harness/build/kuvo-windows-harness.exe",
        "to": "harness/kuvo-windows-harness.exe"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "sign": null,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "Ggboykxz",
      "repo": "kuvo-code",
      "releaseType": "prerelease"
    }
  }
}
