{
  "name": "kuvo-windows-harness",
  "private": true,
  "description": "The Windows harness: the pinned engine, and a small conversation view over its HTTP API.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build:exe": "node build-exe.mjs",
    "smoke:exe": "node smoke-exe.mjs",
    "test": "node --test harness.test.mjs",
    "test:live": "node --test --test-concurrency=1 live.test.mjs ui.dom.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "playwright": "^1.64.1",
    "postject": "^1.0.0-alpha.6"
  }
}
